<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/button_active" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="2dp" android:color="@color/lift_b" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lift_b_light" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="2dp" android:color="@color/lift_b" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/button_inactive" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="1dp" android:color="@color/lift_b" />
        </shape>
    </item>
</selector>
